# ============================================================
#  Homepage Dashboard — Variables d'environnement
#  Copier ce fichier en .env et remplir les valeurs réelles
# ============================================================

# IP du serveur
SERVER_IP=192.168.1.31

# --- Home Assistant ---
# Profil → Sécurité → Créer un jeton d'accès longue durée
HOMEPAGE_VAR_HASS_TOKEN=your_home_assistant_long_lived_token

# --- Sonarr ---
# Paramètres → Général → Clé API
HOMEPAGE_VAR_SONARR_KEY=your_sonarr_api_key

# --- Radarr ---
# Paramètres → Général → Clé API
HOMEPAGE_VAR_RADARR_KEY=your_radarr_api_key

# --- Lidarr ---
# Paramètres → Général → Clé API
HOMEPAGE_VAR_LIDARR_KEY=your_lidarr_api_key

# --- Jackett ---
# Tableau de bord → Clé API en haut de page
HOMEPAGE_VAR_JACKETT_KEY=your_jackett_api_key

# --- Jellyfin ---
# Administration → Clés API → Ajouter une clé
HOMEPAGE_VAR_JELLYFIN_KEY=your_jellyfin_api_key

# --- Transmission ---
# Préférences → Accès à distance
HOMEPAGE_VAR_TRANSMISSION_USER=admin
HOMEPAGE_VAR_TRANSMISSION_PASS=your_transmission_password

# --- Portainer ---
# Utilisateur → Mon compte → Clés d'accès
HOMEPAGE_VAR_PORTAINER_KEY=your_portainer_api_key

# --- Immich ---
# Compte → Clés API
HOMEPAGE_VAR_IMMICH_KEY=your_immich_api_key

# --- Grafana ---
HOMEPAGE_VAR_GRAFANA_USER=admin
HOMEPAGE_VAR_GRAFANA_PASS=your_grafana_password

# --- Nextcloud ---
HOMEPAGE_VAR_NEXTCLOUD_USER=admin
HOMEPAGE_VAR_NEXTCLOUD_PASS=your_nextcloud_password

# --- Nginx Proxy Manager ---
# Email et mot de passe du compte admin NPM
HOMEPAGE_VAR_NPM_USER=your_npm_admin_email
HOMEPAGE_VAR_NPM_PASS=your_npm_password

# --- Vaultwarden (Bitwarden) ---
# Admin panel → Users → API key
HOMEPAGE_VAR_VAULTWARDEN_KEY=your_vaultwarden_client_secret
